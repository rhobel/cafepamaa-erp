NODE_ENV=development
PORT=5050
# Local: a single-node replica set (needed for transactions from Sprint 2).
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=mongodb://127.0.0.1:27017/pamaa_dev
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
CLIENT_URL=http://localhost:5180

# Only read by `npm run seed:admin`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Optional image upload (Cloudinary). Leave empty to paste image URLs instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
