{
  "name": "@pamaa/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed:admin": "node --env-file-if-exists=.env src/scripts/seed-admin.js",
    "seed:invoices": "node --env-file-if-exists=.env src/scripts/seed-invoices.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "import:setup": "node --env-file-if-exists=.env src/scripts/import-setup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  }
}
